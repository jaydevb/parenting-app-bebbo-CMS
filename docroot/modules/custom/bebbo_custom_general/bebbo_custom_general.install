<?php

/**
 * @file
 * Install and update hooks for Bebbo Custom General.
 */

/**
 * Remove defunct custom_serialization and pb_custom_standard_deviation modules.
 *
 * These modules were deleted from disk but may still be registered in the
 * active core.extension config and system.schema key_value store. Running
 * this during updb (before cim) prevents the "module does not exist" crash.
 */
function bebbo_custom_general_update_10001(): string {
  $removed = [];
  $modules_to_remove = [
    'custom_serialization',
    'pb_custom_rest_api',
    'pb_custom_standard_deviation',
  ];

  $config = \Drupal::configFactory()->getEditable('core.extension');
  $module_list = $config->get('module') ?? [];

  foreach ($modules_to_remove as $module) {
    if (array_key_exists($module, $module_list)) {
      unset($module_list[$module]);
      $removed[] = $module;
    }
  }

  if ($removed) {
    $config->set('module', $module_list)->save();
  }

  // Clean up schema entries.
  \Drupal::database()->delete('key_value')
    ->condition('collection', 'system.schema')
    ->condition('name', $modules_to_remove, 'IN')
    ->execute();

  if ($removed) {
    return 'Removed defunct modules from core.extension: ' . implode(', ', $removed);
  }
  return 'No defunct modules found in core.extension; schema entries cleaned.';
}

/**
 * Re-apply menu_per_role roles on editorial menu links from menu_export config.
 *
 * Update 10002 already ran on sites installed before this hook existed, so it
 * will not pick up later corrections to the show/hide role values in
 * menu_export.export_data.yml. Importing that config via cim does not help
 * either: the menu links are content entities, not config. This re-applies just
 * the two menu_per_role fields, keyed by uuid, leaving titles/paths/weights
 * untouched.
 *
 * Reads the sync storage rather than active config: the deploy hook runs updb
 * before cim, so at this point active config still holds the previous values.
 */
function bebbo_custom_general_update_10003(): string {
  $export_data = \Drupal::service('config.storage.sync')->read('menu_export.export_data');
  if (empty($export_data)) {
    // No sync directory available (e.g. a site configured without one).
    $export_data = \Drupal::config('menu_export.export_data')->get();
  }
  $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  $fields = ['menu_per_role__show_role', 'menu_per_role__hide_role'];
  $updated = 0;

  foreach ($export_data as $menu) {
    if (!is_array($menu) || !isset($menu['uuid']['value'])) {
      continue;
    }
    if (($menu['menu_name']['value'] ?? NULL) !== 'editorial-menu') {
      continue;
    }
    $existing = $storage->loadByProperties(['uuid' => $menu['uuid']['value']]);
    if (!$existing) {
      continue;
    }
    $entity = reset($existing);
    foreach ($fields as $field_name) {
      // menu_export writes FALSE when a link carries no roles; an empty array
      // is what clears a multi-value entity_reference field.
      $value = $menu[$field_name] ?? NULL;
      $entity->set($field_name, empty($value) ? [] : $value);
    }
    $entity->save();
    $updated++;
  }

  return "Re-applied menu_per_role roles on $updated editorial menu link(s).";
}

/**
 * Sync editorial menu items across all sites from menu_export config.
 *
 * Deletes orphan editorial-menu items whose UUIDs don't match config,
 * then imports/updates all 43 canonical items via menu_export.
 */
function bebbo_custom_general_update_10002(): string {
  $config = \Drupal::config('menu_export.export_data');
  $export_data = $config->get();

  // Collect canonical UUIDs from menu_export config.
  $canonical_uuids = [];
  foreach ($export_data as $item) {
    if (is_array($item) && isset($item['uuid']['value'])) {
      $canonical_uuids[] = $item['uuid']['value'];
    }
  }

  if (empty($canonical_uuids)) {
    return 'No menu_export config found — skipping editorial menu sync.';
  }

  // Delete orphan editorial-menu items (UUIDs not in config).
  $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  $query = $storage->getQuery()
    ->condition('menu_name', 'editorial-menu')
    ->condition('uuid', $canonical_uuids, 'NOT IN')
    ->accessCheck(FALSE);
  $orphan_ids = $query->execute();
  $deleted_count = 0;

  if (!empty($orphan_ids)) {
    $orphans = $storage->loadMultiple($orphan_ids);
    $storage->delete($orphans);
    $deleted_count = count($orphans);
  }

  // Import canonical items from menu_export config (inline logic from
  // MenuImportForm::importMenus to avoid constructor dependency).
  $created = 0;
  $updated = 0;
  foreach ($export_data as $menu) {
    if (!is_array($menu) || !isset($menu['menu_name']['value'])) {
      continue;
    }
    if ($menu['menu_name']['value'] !== 'editorial-menu') {
      continue;
    }
    unset($menu['id'], $menu['revision_id']);
    $existing = $storage->loadByProperties(['uuid' => $menu['uuid']['value']]);

    if ($existing) {
      $entity = reset($existing);
      $updated++;
    }
    else {
      $entity = $storage->create();
      $created++;
    }
    foreach ($menu as $field_name => $value) {
      $entity->set($field_name, $value);
    }
    $entity->save();
  }

  return "Editorial menu sync: deleted $deleted_count orphans, created $created, updated $updated items.";
}

/**
 * Show the Manage Reports menu links to editors.
 *
 * The editorial menu lives in each site's database, not in config, so widening
 * the visibility of a link has to be done per site. Country Reports and the
 * standard deviation export are now open to the editor role, but a child link
 * stays hidden while one of its ancestors is not shown, so the whole chain up
 * to Manage Reports gets the role.
 *
 * Links with no show_role are already visible to every role - adding a role
 * there would restrict them instead of widening them, so they are left alone.
 */
function bebbo_custom_general_update_10004(): string {
  $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  $uris = [
    'internal:/country-reports',
    'internal:/taxonomy-export-standard-deviation/en',
  ];
  $updated = [];

  foreach ($uris as $uri) {
    $links = $storage->loadByProperties([
      'menu_name' => 'editorial-menu',
      'link.uri' => $uri,
    ]);

    foreach ($links as $link) {
      // Walk the link and every ancestor above it.
      while ($link) {
        $roles = array_column($link->get('menu_per_role__show_role')->getValue(), 'target_id');
        if ($roles && !in_array('editor', $roles, TRUE)) {
          $roles[] = 'editor';
          $link->set('menu_per_role__show_role', $roles);
          $link->save();
          $updated[] = $link->label();
        }

        $parent = $link->getParentId();
        $link = NULL;
        if ($parent && str_starts_with($parent, 'menu_link_content:')) {
          $parents = $storage->loadByProperties(['uuid' => substr($parent, strlen('menu_link_content:'))]);
          $link = $parents ? reset($parents) : NULL;
        }
      }
    }
  }

  if (!$updated) {
    return 'No editorial menu links needed the editor role.';
  }
  return 'Granted the editor role on: ' . implode(', ', array_unique($updated)) . '.';
}
