<?php

/**
 * @file
 * Hook implementations for the Bebbo Serializer module.
 */

use Drupal\node\NodeInterface;
use Drupal\views\ViewExecutable;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\Core\Form\FormStateInterface;
use Drupal\views\Plugin\views\query\Sql;

/**
 * Implements hook_views_query_alter().
 *
 * When ?pregnancy=true is present on the articles endpoint, adds the
 * Pregnancy term TID to the child_age filter so pregnancy-tagged
 * articles are included in the results.
 */
function bebbo_serializer_views_query_alter(ViewExecutable $view, QueryPluginBase $query): void {
  if (!$query instanceof Sql) {
    return;
  }
  if ($view->id() !== 'bebbo_v2_apis' || $view->current_display !== 'articles_rest_export') {
    return;
  }

  $pregnancy_param = \Drupal::request()->query->get('pregnancy');
  if ($pregnancy_param !== 'true') {
    return;
  }

  $terms = \Drupal::entityTypeManager()
    ->getStorage('taxonomy_term')
    ->loadByProperties(['name' => 'Pregnancy', 'vid' => 'child_age']);
  if (empty($terms)) {
    return;
  }

  $pregnancy_tid = (string) reset($terms)->id();

  // Traverse the query's WHERE conditions to find the child_age filter
  // and add the Pregnancy TID to its IN() list.
  // The taxonomy_index_tid filter uses operator "formula" with a nested
  // value array keyed by a placeholder name.
  foreach ($query->where as &$group) {
    if (empty($group['conditions'])) {
      continue;
    }
    foreach ($group['conditions'] as &$condition) {
      if (!isset($condition['field']) || !is_string($condition['field'])) {
        continue;
      }
      if (!str_contains($condition['field'], 'field_child_age_target_id')) {
        continue;
      }
      // Values are nested: [':placeholder[]' => [43 => 43, ...]].
      foreach ($condition['value'] as &$values) {
        if (is_array($values) && !isset($values[$pregnancy_tid])) {
          $values[$pregnancy_tid] = $pregnancy_tid;
        }
      }
    }
  }
}

/**
 * Implements hook_node_presave().
 *
 * Auto-populates field_embedded_images by extracting image URLs
 * from <drupal-media> and <img> tags in the body field.
 *
 * Auto-populates field_body_rendered with pre-rendered body HTML
 * (drupal-media converted to img tags) for article nodes.
 */
function bebbo_serializer_node_presave(NodeInterface $node): void {
  // Auto-compute paragraph counts for course and quiz nodes.
  _bebbo_serializer_populate_number_of_modules($node);
  _bebbo_serializer_populate_number_of_questions($node);

  // Truncate height/weight decimals to max 2 places (no rounding).
  if ($node->bundle() === 'pregnancy_weekly_overview') {
    foreach (['field_average_height', 'field_average_weight'] as $field_name) {
      if ($node->hasField($field_name) && !$node->get($field_name)->isEmpty()) {
        $truncated = _bebbo_serializer_truncate_decimal($node->get($field_name)->value);
        $node->set($field_name, $truncated);
      }
    }
  }

  // Only process published nodes with a body field.
  if (!$node->isPublished() || !$node->hasField('body')) {
    return;
  }

  $body = $node->get('body')->value ?? '';
  $original_body = '';
  if (!$node->isNew() && isset($node->original)) {
    $original_body = $node->original->get('body')->value ?? '';
  }

  _bebbo_serializer_populate_embedded_images($node, $body, $original_body);
  _bebbo_serializer_populate_body_rendered($node, $body, $original_body);
}

/**
 * Populates field_embedded_images from <drupal-media> and <img> tags in body.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The node being saved.
 * @param string $body
 *   Current body value.
 * @param string $original_body
 *   Original body value (empty for new nodes).
 */
function _bebbo_serializer_populate_embedded_images(NodeInterface $node, string $body, string $original_body): void {
  $supported_types = ['activities', 'article', 'page', 'video_article'];

  if (!in_array($node->bundle(), $supported_types, TRUE)) {
    return;
  }

  if (!$node->hasField('field_embedded_images')) {
    return;
  }

  // Skip extraction entirely if body hasn't changed and field is populated.
  $existing = array_column($node->get('field_embedded_images')->getValue(), 'value');
  if ($body === $original_body && !empty($existing)) {
    return;
  }

  // Clear field if body is empty or has no embedded images.
  $hasDrupalMedia = strpos($body, '<drupal-media') !== FALSE;
  $hasImgTags = stripos($body, '<img') !== FALSE;
  if (empty($body) || (!$hasDrupalMedia && !$hasImgTags)) {
    if (!empty($existing)) {
      $node->set('field_embedded_images', []);
    }
    return;
  }

  /** @var \Drupal\bebbo_serializer\Service\BodyImageProcessor $processor */
  $processor = \Drupal::service('bebbo_serializer.body_image_processor');
  $urls = $processor->extractImageUrls($body);

  // Only update field if URLs actually changed.
  if ($urls === $existing) {
    return;
  }

  $node->set('field_embedded_images', $urls);
}

/**
 * Populates field_body_rendered with pre-rendered body HTML for articles.
 *
 * Runs the body through check_markup() to convert <drupal-media> to <img>,
 * then applies cleanup for API output. This moves the rendering work from
 * request time (Views) to save time.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The node being saved.
 * @param string $body
 *   Current body value.
 * @param string $original_body
 *   Original body value (empty for new nodes).
 */
function _bebbo_serializer_populate_body_rendered(NodeInterface $node, string $body, string $original_body): void {
  // Guard: skip content types that don't have the field.
  if (!$node->hasField('field_body_rendered')) {
    return;
  }

  // Skip rendering if body hasn't changed and field is already populated.
  $existing = $node->get('field_body_rendered')->value ?? '';
  if ($body === $original_body && !empty($existing)) {
    return;
  }

  // Clear field if body is empty.
  if (empty($body)) {
    if (!empty($existing)) {
      $node->set('field_body_rendered', NULL);
    }
    return;
  }

  $bodyFormat = $node->get('body')->format ?? 'full_html';
  $langcode = $node->language()->getId();
  $baseUrl = \Drupal::request()->getSchemeAndHttpHost();

  /** @var \Drupal\bebbo_serializer\Service\BodyImageProcessor $processor */
  $processor = \Drupal::service('bebbo_serializer.body_image_processor');
  $rendered = $processor->render($body, $bodyFormat, $langcode, $baseUrl);

  // Only update if the rendered value actually changed.
  if ($rendered === $existing) {
    return;
  }

  $node->set('field_body_rendered', [
    'value' => $rendered,
    'format' => 'full_html',
  ]);
}

/**
 * Sets field_number_of_modules to the count of field_module paragraph items.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The node being saved.
 */
function _bebbo_serializer_populate_number_of_modules(NodeInterface $node): void {
  if ($node->bundle() !== 'course') {
    return;
  }

  if (!$node->hasField('field_module') || !$node->hasField('field_number_of_modules')) {
    return;
  }

  $count = $node->get('field_module')->count();
  $node->set('field_number_of_modules', $count);
}

/**
 * Sets field_number_of_questions from field_question count.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The node being saved.
 */
function _bebbo_serializer_populate_number_of_questions(NodeInterface $node): void {
  if ($node->bundle() !== 'quiz') {
    return;
  }

  if (!$node->hasField('field_question') || !$node->hasField('field_number_of_questions')) {
    return;
  }

  $count = $node->get('field_question')->count();
  $node->set('field_number_of_questions', $count);
}

/**
 * Implements hook_form_alter().
 *
 * Makes paragraph count fields readonly and attaches JS for real-time
 * updates on course and quiz node forms.
 */
function bebbo_serializer_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  // Course: auto-compute number of modules.
  if (in_array($form_id, ['node_course_form', 'node_course_edit_form'], TRUE)) {
    if (isset($form['field_number_of_modules'])) {
      $form['field_number_of_modules']['#disabled'] = TRUE;
    }
    $form['#attached']['library'][] = 'bebbo_serializer/course_module_count';
  }

  // Pregnancy weekly overview: restrict.
  // height/weight to 2 decimal places in real-time.
  if (in_array($form_id, ['node_pregnancy_weekly_overview_form', 'node_pregnancy_weekly_overview_edit_form'], TRUE)) {
    $form['#attached']['library'][] = 'bebbo_serializer/decimal-restriction';
  }

  // Quiz: auto-compute number of questions, validate passing score.
  if (in_array($form_id, ['node_quiz_form', 'node_quiz_edit_form'], TRUE)) {
    if (isset($form['field_number_of_questions'])) {
      $form['field_number_of_questions']['#disabled'] = TRUE;
    }
    if (isset($form['field_passing_score'])) {
      $form['field_passing_score']['widget'][0]['value']['#description'] = t('The passing score out of 0');
    }
    $form['#validate'][] = '_bebbo_serializer_quiz_passing_score_validate';
    $form['#validate'][] = '_bebbo_serializer_quiz_question_count_validate';
    $form['#attached']['library'][] = 'bebbo_serializer/quiz_question_count';
    $form['#attached']['drupalSettings']['bebboQuizType'] = [
      'singleQuestionValue' => 'single_question_quiz',
    ];
  }
}

/**
 * Counts non-removed paragraph items in the field_question form state.
 *
 * The field_number_of_questions widget is #disabled so Drupal resets its
 * submitted value to the default. This helper counts paragraphs directly
 * from form state instead.
 */
function _bebbo_serializer_count_questions(FormStateInterface $form_state): int {
  $questions = $form_state->getValue('field_question');
  if (!is_array($questions)) {
    return 0;
  }

  $count = 0;
  foreach ($questions as $delta => $item) {
    if (!is_numeric($delta) || empty($item['subform'])) {
      continue;
    }
    $count++;
  }
  return $count;
}

/**
 * Validates that passing score does not exceed the number of questions.
 */
function _bebbo_serializer_quiz_passing_score_validate(array &$form, FormStateInterface $form_state): void {
  $passing_score = (int) $form_state->getValue(['field_passing_score', 0, 'value']);
  $question_count = _bebbo_serializer_count_questions($form_state);

  if ($passing_score > $question_count) {
    $form_state->setErrorByName(
      'field_passing_score',
      t('Passing score (@score) cannot exceed the number of questions (@count).', [
        '@score' => $passing_score,
        '@count' => $question_count,
      ])
    );
  }
}

/**
 * Validates that a single question quiz has at most one question.
 */
function _bebbo_serializer_quiz_question_count_validate(array &$form, FormStateInterface $form_state): void {
  $quiz_type = $form_state->getValue(['field_quiz_type', 0, 'value']);
  if ($quiz_type !== 'single_question_quiz') {
    return;
  }

  $question_count = _bebbo_serializer_count_questions($form_state);

  if ($question_count > 1) {
    $form_state->setErrorByName(
      'field_question',
      t('A "Single question quiz" can have at most 1 question. You currently have @count questions.', [
        '@count' => $question_count,
      ])
    );
  }
}

/**
 * Truncates a decimal value to at most 2 decimal places without rounding.
 */
function _bebbo_serializer_truncate_decimal($value): ?string {
  if ($value === NULL || $value === '') {
    return $value;
  }

  $str = (string) $value;
  $dot = strpos($str, '.');
  if ($dot === FALSE) {
    return $str;
  }

  return substr($str, 0, $dot + 3);
}
