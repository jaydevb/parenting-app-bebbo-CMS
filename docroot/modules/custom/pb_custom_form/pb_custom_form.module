<?php

/**
 * @file
 * It contains custom field module.
 */

use Drupal\node\NodeInterface;
use Drupal\views\ViewExecutable;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Entity\RevisionableStorageInterface;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Symfony\Component\HttpFoundation\RedirectResponse;

/**
 * Implements hook_views_query_alter().
 */
function pb_custom_form_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  // Check if it's your specific view and display.
  if ($view->id() == 'articles' && $view->current_display == 'rest_export_2') {

    // Retrieve the contextual filter value.
    // Adjust index based on your view's configuration.
    // Retrieve all query parameters from the URL.
    $query_params = \Drupal::request()->query->all();

    // Check if the 'version' parameter is passed and is set to 2.
    // $query_params['version'] == '2'.
    if (isset($query_params['pregnancy']) && $query_params['pregnancy'] == 'true') {

      // Remove 'Child Age' filter (<> Pregnancy) condition dynamically.
      // Look for the condition related to 'Child Age' and remove it from the
      // query. Assuming 'field_child_age' is the machine name of the 'Child
      // Age' field.
      // @phpstan-ignore-next-line
      foreach ($query->where as &$where) {
        if (!empty($where['conditions'])) {
          foreach ($where['conditions'] as &$condition) {

            $field_condition = 'node__field_child_age.field_child_age_target_id IN(:node__field_child_age_field_child_age_target_id[])';
            if (isset($condition['field']) && $condition['field'] == $field_condition) {

              $terms = \Drupal::service('entity_type.manager')
                ->getStorage('taxonomy_term')->loadByProperties([
                  'name' => 'Pregnancy',
                  'vid' => 'child_age',
                ]);
              // Check if the term exists and return its name.
              if ($terms) {
                // Get the first term if there are multiple results.
                $term = reset($terms);
                $tid_pregnancy = (int) $term->id();
                $condition['value'][':node__field_child_age_field_child_age_target_id[]'][] = $tid_pregnancy;

              }
            }
          }
        }
      }
    }
  }
}

/**
 * Implements hook_form_alter().
 */
function pb_custom_form_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Adding custom validation for the welcome page type field.
  if ($form_id == 'group_country_edit_form') {
    // Make readonly if offload country is enabled.
    $user = \Drupal::currentUser();
    $roles = $user->getRoles();
    $global_user = ['global_admin'];
    if (count(array_intersect($roles, $global_user)) != 0) {
      $mobile_default = $form['field_make_available_for_mobile']['widget']['value']['#default_value'];
      if ($mobile_default == 1) {
        $form['field_make_available_for_mobile']['widget']['value']['#disabled'] = 'true';
      }
      else {
        $form['field_make_available_for_mobile']['widget']['value']['#default_value'] = 'true';
      }
    }
    /* $form['#attached']['js'][] = drupal_get_path('module', 'pb_custom_field') . '/js/homepage.js'; */
    $form['#attached']['library'][] = 'pb_custom_field/mylib';
    $form['actions']['submit']['#submit'][] = 'bebbo_custom_general_group_country_save';
  }
}

/**
 * Implements hook_preprocess_views_view_field().
 */
function pb_custom_form_pb_custom_field_preprocess_views_view_field(&$variables) {
  if ($variables['field']->field == 'revision_uid') {
    $langcode = $variables['row']->node_field_data_langcode;
    $nid = $variables['row']->_entity->nid->value;
    $storage = \Drupal::entityTypeManager()->getStorage('node');
    /** @var \Drupal\node\NodeStorageInterface $storage */
    $vid = $storage->getLatestRevisionId($nid);
    if ($storage instanceof RevisionableStorageInterface) {
      /** @var \Drupal\Core\Entity\RevisionableStorageInterface $storage */
      $node = $storage->loadRevision($vid);
    }
    else {
      $node = NULL;
    }
    if ($node instanceof NodeInterface) {
      $storage = \Drupal::entityTypeManager()
        ->getStorage($node->getEntityTypeId());
      /** @var \Drupal\Core\Entity\ContentEntityStorageInterface $storage */
      $revision_id = $storage->getLatestTranslationAffectedRevisionId($node->id(),
        $langcode);
      if ($storage instanceof RevisionableStorageInterface) {
        /** @var \Drupal\Core\Entity\RevisionableStorageInterface $storage */
        $revisionNode = $storage->loadRevision($revision_id);
      }
      else {
        $revisionNode = NULL;
      }
      /** @var \Drupal\Core\Entity\TranslatableInterface $revisionNode */
      $revisionTransNode = $revisionNode->getTranslation($langcode);
      /** @var \Drupal\node\NodeInterface $revisionTransNode */
      $uid = $revisionTransNode->get('revision_uid')->target_id ?? NULL;
      $objUser = \Drupal::entityTypeManager()->getStorage('user')->load($uid);
      $variables['output'] = $objUser->name->value;
    }
  }

  $view = $variables['view'];
  $field = $variables['field'];

  if ($view->storage->id() == 'country_content_listing' && $view->current_display == 'page_5' && $field->field == 'moderation_state') {
    // Get the row entity (in this case, assuming a node).
    if (isset($variables['row']->_entity) && $variables['row']->_entity instanceof NodeInterface) {
      // $node = $variables['row']->_entity;
      $nid = $variables['row']->_entity->id();
      $storage_node = \Drupal::entityTypeManager()->getStorage('node');
      /** @var \Drupal\node\NodeStorageInterface $storage_node */
      $vid = $storage_node->getLatestRevisionId($nid);

      if ($storage_node instanceof RevisionableStorageInterface) {
        /** @var \Drupal\Core\Entity\RevisionableStorageInterface $storage_node */
        $node = $storage_node->loadRevision($vid);
      }
      else {
        $node = NULL;
      }

      $field_language = $variables['row']->{'node_field_data_langcode'} ?? NULL;

      // Get the moderation information service.
      $moderation_information = \Drupal::service('content_moderation.moderation_information');

      // Check if the node is moderated.
      if ($moderation_information->isModeratedEntity($node)) {

        if ($variables['field']->field == 'moderation_state') {
          /** @var \Drupal\node\NodeInterface $node */
          if ($node->hasField('moderation_state')) {
            $storage = \Drupal::entityTypeManager()
              ->getStorage($node->getEntityTypeId());
            /** @var \Drupal\Core\Entity\ContentEntityStorageInterface $storage */
            $revision_id = $storage->getLatestTranslationAffectedRevisionId($node->id(),
              $field_language);
            if ($storage instanceof RevisionableStorageInterface) {
              /** @var \Drupal\Core\Entity\RevisionableStorageInterface $storage */
              $revisionNode = $storage->loadRevision($revision_id);
            }
            else {
              $revisionNode = NULL;
            }
            if ($revisionNode instanceof ContentEntityInterface) {
              $info = $moderation_information->getAffectedRevisionTranslation($revisionNode);
              if ($info instanceof ContentEntityInterface) {
                $moderation_state = $info->get('moderation_state')->value;

                $workflow = $moderation_information->getWorkflowForEntity($info);
                $label = $workflow->getTypePlugin()
                  ->getState($moderation_state)->label();
                $variables['output'] = $label;

              }
            }
          }
        }

      }
    }
  }

}

/**
 * Implements hook_views_post_execute().
 *
 * This hook avoids duplicate entry of nodes in view to optimize API
 * performance.
 */
function pb_custom_form_views_post_execute(ViewExecutable $view) {
  // For chil growth api.
  if ($view->id() == 'articles') {
    $display = $view->getDisplay()->display['id'];
    $dedupe = function (array $rows, string $field_name) {
      $seen = [];
      $result = [];
      foreach ($rows as $row) {
        // ✅ Safe dynamic access
        $id = $row->{$field_name} ?? NULL;
        if ($id && !in_array($id, $seen, TRUE)) {
          $seen[] = $id;
          $result[] = $row;
        }
      }
      return $result;
    };
    switch ($display) {
      // Child Growth Pinned Content API.
      case 'rest_export_18':
        // Milestone Related Content API.
      case 'rest_export_20':
        $view->result = $dedupe($view->result, 'node_field_data_node__field_related_articles_nid');
        break;

      // Health Check-Ups Pinned Content API.
      case 'rest_export_17':
        // FAQ Pinned Content API  // api/pinned-contents/en/faq.
      case 'rest_export_1':
        // FAQ Updated Pinned Content API
        // api/updated-pinned-contents/en/faq.
      case 'rest_export_21':
        $view->result = $dedupe($view->result, 'node_field_data_node__field_pinned_article_nid');
        break;

      // Child Development Girl Pinned Content API
      // api/pinned-contents/en/child_development/41.
      case 'rest_export_16':
        $view->result = $dedupe($view->result, 'node_field_data_node__field_pinned_article_for_girl_nid');
        break;

      // Vaccinations Pinned Content API.
      case 'rest_export_12':
        // Not able to test this as the data is empty.
        break;

      // Child Development Boy Pinned Content API
      // api/pinned-contents/en/child_development/40.
      case 'rest_export_19':
        $view->result = $dedupe($view->result, 'node_field_data_node__field_pinned_article_for_boy_nid');
        break;

      // Case 'rest_export_2': // Article API.
      default:
    }
  }
}

/**
 * For redirect page.
 */
function pb_custom_form_my_goto($path) {
  $response = new RedirectResponse($path);
  $response->send();
  return $response;
}
